# Copie para .env (gitignorado) e preencha. NUNCA commite valores reais.
# Em produção estas variáveis ficam nos secrets da plataforma, não em arquivo.

APP_ENV=development
# Vazio = SQLite local em data/leads.db. Preenchido = Postgres (Neon).
DATABASE_URL=
# Assina o cookie de sessão. Gere com: python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=
# Autoriza criar o 1º administrador.
APP_PASSWORD=
# Chave Fernet que cifra a senha SMTP dos remetentes.
# Gere com: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
EMAIL_ENC_KEY=
# Conta que envia o código de "esqueci a senha".
SMTP_FROM=
SMTP_PASSWORD=
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
# Origens extras liberadas no CORS (normalmente vazio: o front usa o proxy da Vercel).
CORS_ORIGINS=
