{
  // API do ProspectAI na Cloudflare. Publicada pelo GitHub Actions
  // (.github/workflows/deploy-api.yml) — não rode deploy manual.
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "prospectai-api",
  "main": "src/index.ts",
  "compatibility_date": "2026-10-01",
  "observability": { "enabled": true },
  "containers": [
    {
      "class_name": "ApiContainer",
      "image": "../Dockerfile",
      "image_build_context": "..",
      // 1 instância: a fila de lotes vive na memória do processo.
      "max_instances": 1,
      // O motor baixa dezenas de páginas em paralelo; abaixo disso falta memória.
      "instance_type": "standard-1"
    }
  ],
  "durable_objects": {
    "bindings": [{ "name": "API", "class_name": "ApiContainer" }]
  },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["ApiContainer"] }]
}
